NODE_ENV="development"
PORT=3333
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public"
TEST_DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk_test?schema=public"
JWT_SECRET="troque-por-um-segredo-com-16-ou-mais-caracteres"
JWT_EXPIRES_IN="1d"

# Endereços do frontend que podem chamar a API, separados por vírgula.
# Opcional no desenvolvimento (qualquer origem é aceita) e obrigatório com NODE_ENV="production".
CORS_ORIGIN="http://localhost:5173"

# Senha das contas criadas pelo seed. Sem ela, o seed usa 123456 no desenvolvimento e falha em produção.
SEED_PASSWORD="troque-esta-senha"
